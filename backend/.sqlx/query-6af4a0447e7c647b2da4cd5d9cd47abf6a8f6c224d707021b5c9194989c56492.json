  "query": "\n                INSERT INTO rankings\n                    (user_id, map, agent, rank)\n                VALUES ($1, $2, $3, $4)\n                ON CONFLICT (user_id, map, agent)\n                DO UPDATE SET\n                    rank = EXCLUDED.rank\n                RETURNING (old.id IS NULL) AS \"created!\"\n                ",
