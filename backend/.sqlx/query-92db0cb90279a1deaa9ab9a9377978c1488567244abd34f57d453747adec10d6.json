{
  "db_name": "PostgreSQL",
  "query": "UPDATE sessions\n        SET\n            access_token_hash = $3,\n            refresh_token_hash = $4,\n            refreshed_at = now(),\n            access_expires_at = now() + $5\n        WHERE\n            user_id = $2\n            AND refresh_token_hash = $1\n            AND expires_at > now()\n            AND revoked_at IS NULL\n        RETURNING\n            id,\n            created_at,\n            refreshed_at,\n            expires_at,\n            access_expires_at,\n            access_token_hash,\n            refresh_token_hash",
